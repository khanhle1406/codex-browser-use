{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "version": "1.1.0",
  "description": "Multi-agent browser automation bridge matching OpenAI Codex architecture 100% with virtual cursor and tab favicon badge.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "scripting",
    "webNavigation",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
