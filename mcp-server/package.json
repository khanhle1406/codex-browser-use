{
  "name": "agent-browser-use",
  "version": "3.0.0",
  "description": "Let any coding agent control your real Chrome browser — a fast, open-source clone of Codex Browser Use.",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanhle1406/codex-browser-use.git"
  },
  "homepage": "https://github.com/khanhle1406/codex-browser-use",
  "bugs": {
    "url": "https://github.com/khanhle1406/codex-browser-use/issues"
  },
  "keywords": ["browser-use", "browser-automation", "mcp", "chrome", "accessibility-tree", "agent", "cdp"],
  "files": ["src", "bin", "extension", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "browser-use": "bin/browser-use.js"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/*.js bin test",
    "bench": "node bench/perf-benchmark.mjs",
    "bench:agents": "node bench/agent-benchmark.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.19.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "10.15.0"
  }
}
