{
  "name": "codex-browser-use",
  "version": "4.9.0",
  "description": "Fast, token-efficient local MCP server that gives any coding agent your real Chrome browser.",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanhle1406/codex-browser-use.git"
  },
  "homepage": "https://codex-browser-use.vercel.app",
  "bugs": {
    "url": "https://github.com/khanhle1406/codex-browser-use/issues"
  },
  "keywords": ["codex-browser-use", "browser-use", "browser-automation", "mcp", "mcp-server", "chrome", "claude-code", "cursor", "codex", "antigravity", "windsurf", "accessibility-tree", "agent", "cdp"],
  "files": ["src", "bin", "extension", "skill", "rules", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codex-browser-use": "bin/browser-use.js",
    "browser-use": "bin/browser-use.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "prepack": "node scripts/stage-package.mjs pack",
    "postpack": "node scripts/stage-package.mjs clean",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/*.js bin test",
    "bench": "node bench/perf-benchmark.mjs",
    "bench:agents": "node bench/agent-benchmark.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.19.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "10.15.0"
  }
}
