{
  "manifest_version": 3,
  "name": "Portable Browser Bridge",
  "version": "0.5.6",
  "description": "Connect the local Browser Use adapter to Chrome tabs with live virtual cursor and tab badges.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "debugger", "downloads", "tabGroups", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/cursor-chat.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Connect or disconnect Portable Browser Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
